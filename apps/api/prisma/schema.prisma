generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
  CUSTOMER
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  users     User[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  /** Имя (необязательно) */
  firstName    String?
  /** Фамилия (необязательно) */
  lastName     String?
  /** Отчество (необязательно) */
  patronymic   String?
  passwordHash String
  role         Role
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
  timeEntries  TimeEntry[]
}

model Stage {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  sortOrder   Int
  isComplete  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]     @relation("OrderCurrentStage")
  timeEntries TimeEntry[]
}

/** Тип фрезеровки, цена за м² площади фасада. */
model MillingType {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  pricePerM2 Float
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  facades    Facade[]
}

/** Тип покрытия, цена за м². */
model CoatingType {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  pricePerM2 Float
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  facades    Facade[]
}

/** Тип интегрированной ручки, цена за погонный метр. */
model HandleType {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  pricePerMeter  Float
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  facades        Facade[]
}

model Order {
  id              String    @id @default(uuid())
  /** SQLite: autoincrement только на PK — номер выдаём в коде при create. */
  orderNumber     Int       @unique
  createdAt       DateTime  @default(now())
  deadlineAt      DateTime?
  comment         String?
  overridePercent Float?
  overridePrice   Float?
  totalPrice      Float?
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  currentStageId  String
  currentStage    Stage     @relation("OrderCurrentStage", fields: [currentStageId], references: [id])
  updatedAt       DateTime    @updatedAt
  facades         Facade[]
  timeEntries     TimeEntry[]
}

model TimeEntry {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id])
  /** Длительность, минуты */
  minutes   Int
  comment   String?
  workedAt  DateTime
  createdAt DateTime @default(now())
}

model Facade {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortIndex  Int     @default(0)
  color      String  @default("")
  widthMm    Float
  heightMm   Float
  thicknessMm Float

  millingTypeId String
  millingType   MillingType @relation(fields: [millingTypeId], references: [id], onDelete: Restrict)

  coatingTypeId String
  coatingType   CoatingType @relation(fields: [coatingTypeId], references: [id], onDelete: Restrict)

  handleTypeId   String?
  handleType     HandleType? @relation(fields: [handleTypeId], references: [id], onDelete: Restrict)
  /** Длина интегрированной ручки, мм (если выбран тип ручки). */
  handleLengthMm Float?

  edgeRadius   Float?
  optionsExtra String?
  /** Базовая цена позиции, посчитанная на клиенте и сохранённая вместе с заказом */
  basePrice    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  message    String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
}
