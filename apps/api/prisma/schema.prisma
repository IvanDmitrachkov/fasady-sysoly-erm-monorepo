generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  id              String   @id @default(uuid())
  name            String
  phone           String?
  deliveryAddress String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  users           User[]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  /// * Имя (необязательно)
  firstName    String?
  /// * Фамилия (необязательно)
  lastName     String?
  /// * Отчество (необязательно)
  patronymic   String?
  passwordHash String
  role         Role
  customerId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  orderComments OrderComment[]
  timeEntries  TimeEntry[]
  materialEntries OrderMaterialEntry[]
  customer     Customer?   @relation(fields: [customerId], references: [id])
}

model Stage {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  sortOrder   Int
  isComplete  Boolean     @default(false)
  allowWorkStates Boolean @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]     @relation("OrderCurrentStage")
  timeEntries TimeEntry[]
  materialEntries OrderMaterialEntry[]
}

/// * Под-статус заказа на текущем этапе (очередь / в работе / …). Справочник в БД.
model OrderWorkState {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

/// * Тип фрезеровки (справочник для подсказок), цена за м² — ориентир.
model MillingType {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  pricePerM2 Float
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// * Тип покрытия, цена за м².
model CoatingType {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  pricePerM2 Float
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  facades    Facade[]
}

/// * Тип интегрированной ручки (справочник для подсказок), цена за п.м. — ориентир.
model HandleType {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  pricePerMeter Float
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                  String      @id @default(uuid())
  /// * Номер выдаём в коде при create, чтобы сохранить бизнес-нумерацию отдельно от id.
  orderNumber         Int         @unique
  createdAt           DateTime    @default(now())
  completedAt         DateTime?
  deletedAt           DateTime?
  deadlineAt          DateTime?
  workType            String?
  deliveryAddress     String?     @db.Text
  comment             String?     @db.Text
  /// * Количество фасадов штук
  facadeCount         Int         @default(0)
  /// * Цена одного кв.м фасада (редактируется менеджером)
  facadePricePerM2    Float?
  /// * Общая площадь фасадов, м² (вычисляется)
  facadeAreaTotal     Float       @default(0)
  /// * Стоимость прямых фасадов, руб. = facadeAreaTotal * facadePricePerM2
  facadeCostTotal     Float?
  /// * Цена за кв.м фрезеровки (редактируется менеджером)
  millingPricePerM2   Float?
  /// * Стоимость фрезеровки, руб. = facadeAreaTotal * millingPricePerM2
  millingCostTotal    Float?
  /// * Длина интегрированной ручки, мм (суммарно, вводит менеджер)
  handleLengthTotalMm Float?
  /// * Цена метра интегрированной ручки (редактируется менеджером)
  handlePricePerMeter Float?
  /// * Стоимость интегрированной ручки, руб. = handleLengthTotalMm/1000 * handlePricePerMeter
  handleCostTotal     Float?
  /// * Прочие услуги, цена (отдельное поле)
  otherServicesPrice  Float?
  /// * Итого, руб. = facadeCostTotal + millingCostTotal + handleCostTotal + otherServicesPrice
  subtotal            Float?
  /// * Скидка, руб (вводит пользователь)
  discount            Float?
  /// * Общая стоимость = subtotal - discount
  totalCost           Float?
  /// * Аванс (новое поле)
  advance             Float?
  customerId          String
  currentStageId      String
  workStateId         String
  updatedAt           DateTime    @updatedAt
  facades             Facade[]
  currentStage        Stage       @relation("OrderCurrentStage", fields: [currentStageId], references: [id])
  workState           OrderWorkState @relation(fields: [workStateId], references: [id])
  customer            Customer    @relation(fields: [customerId], references: [id])
  comments            OrderComment[]
  timeEntries         TimeEntry[]
  materialEntries     OrderMaterialEntry[]
}

model OrderComment {
  id        String           @id @default(uuid())
  orderId   String
  userId    String
  type      OrderCommentType @default(NOTE)
  text      String           @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
}

model TimeEntry {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  stageId   String
  /// * Начало работы по записи.
  startedAt DateTime?
  /// * Окончание работы по записи (null = запись открыта).
  endedAt   DateTime?
  /// * Длительность, минуты
  minutes   Int
  comment   String?
  workedAt  DateTime
  createdAt DateTime @default(now())
  stage     Stage    @relation(fields: [stageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, startedAt])
  @@index([orderId, endedAt])
}

model OrderMaterialEntry {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  stageId   String?
  name      String
  unit      String
  quantity  Float
  comment   String?
  usedAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  stage     Stage?   @relation(fields: [stageId], references: [id])

  @@index([orderId, usedAt])
}

model Facade {
  id             String      @id @default(uuid())
  orderId        String
  sortIndex      Int         @default(0)
  color          String      @default("")
  widthMm        Float
  heightMm       Float
  quantity       Int         @default(1)
  thicknessMm    Float
  /// * Фрезеровка (текст позиции; может совпадать со справочником или быть своим).
  millingLabel   String      @default("")
  coatingTypeId  String
  /// * Интегрированная ручка (текст); null — без ручки.
  handleLabel    String?
  /// * Длина интегрированной ручки, мм (если указана ручка).
  handleLengthMm Float?
  edgeRadius     Float?
  optionsExtra   String?     @db.Text
  /// * Базовая цена позиции, посчитанная на клиенте и сохранённая вместе с заказом
  basePrice      Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  coatingType    CoatingType @relation(fields: [coatingTypeId], references: [id])
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  message    String   @db.Text
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  WORKER
  CUSTOMER
}

enum OrderCommentType {
  NOTE
  DEFECT
  INCIDENT
}
