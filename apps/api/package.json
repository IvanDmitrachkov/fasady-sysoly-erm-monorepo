{
  "name": "@erm/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node scripts/copy-templates.mjs && node scripts/copy-web.mjs",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/blocked-db-command.mjs db:migrate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "node scripts/baseline-existing-db.mjs",
    "db:push": "node scripts/blocked-db-command.mjs db:push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/blocked-db-command.mjs db:reset",
    "db:clear-orders": "tsx scripts/clear-orders.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pdfkit": "^0.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.7",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
