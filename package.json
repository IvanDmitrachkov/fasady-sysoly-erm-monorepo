{
  "name": "fasady-sysoly-erm",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"yarn workspace @erm/api dev\" \"yarn workspace @erm/web dev\"",
    "dev:api": "yarn workspace @erm/api dev",
    "dev:web": "yarn workspace @erm/web dev",
    "build": "yarn workspace @erm/web build && yarn workspace @erm/api build",
    "build:web": "yarn workspace @erm/web build",
    "build:api": "yarn workspace @erm/api build",
    "db:generate": "yarn workspace @erm/api db:generate",
    "db:migrate": "yarn workspace @erm/api db:migrate",
    "db:seed": "yarn workspace @erm/api db:seed",
    "db:studio": "yarn workspace @erm/api db:studio",
    "db:reset": "yarn workspace @erm/api db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
